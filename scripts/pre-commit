#!/usr/bin/env sh
# Pre-commit secret scan. Install once with:
#   git config core.hooksPath scripts
# Requires gitleaks (https://github.com/gitleaks/gitleaks). If it is not
# installed the hook warns and lets the commit through — CI runs the same
# scan as a hard gate.

if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --redact --config .gitleaks.toml
    status=$?
    if [ $status -ne 0 ]; then
        echo ""
        echo "✗ gitleaks found something that looks like a secret in your staged changes."
        echo "  Remove it (use placeholders like YOUR_GROK_KEY_HERE) and try again."
        exit $status
    fi
else
    echo "⚠ gitleaks not installed — skipping local secret scan (CI will still run it)."
fi
